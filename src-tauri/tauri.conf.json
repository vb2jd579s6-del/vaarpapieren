{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaarpapieren",
  "version": "1.3.1",
  "identifier": "nl.tharsis.vaarpapieren",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vaarpapieren",
        "width": 1100,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/files/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NzZGNEE2QzExMzg2MzIKUldReWhoUEJwdlIyZEdETWNlK1A3djI4MndRcFlWYzl5dkc5K2JPekdLcXQ1eHRUQkZOWDM2cVgK",
      "endpoints": [
        "https://github.com/vb2jd579s6-del/vaarpapieren/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
